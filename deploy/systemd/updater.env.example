AIF_RELEASE_ROOT=/opt/ai-image-factory
AIF_UPDATE_JOURNAL_ROOT=/var/lib/ai-image-factory/updater
AIF_UPDATER_DATABASE_URL=postgresql://UPDATER_USER:PASSWORD@DATABASE_HOST:5432/ai_image_factory
AIF_MIGRATOR_DATABASE_URL=postgresql://MIGRATOR_USER:PASSWORD@DATABASE_HOST:5432/ai_image_factory
GATEWAY_DATABASE_SCHEMA=public
GATEWAY_ARTIFACT_ROOT=/var/lib/ai-image-factory/artifacts
AIF_UPDATE_GH_EXECUTABLE=/usr/bin/gh
AIF_UPDATE_TAR_EXECUTABLE=/usr/bin/tar
AIF_UPDATE_ATTESTATION_WORKFLOW=.github/workflows/release.yml
# Required before AIF_UPDATE_APPLY_ENABLED can be set to true. Both scripts
# must be root-owned, non-writable by other users, idempotent, and must close
# or open the real public reverse-proxy admission path.
# AIF_UPDATE_ADMISSION_CLOSE_HOOK=/etc/ai-image-factory/update-hooks/admission-close
# AIF_UPDATE_ADMISSION_OPEN_HOOK=/etc/ai-image-factory/update-hooks/admission-open
AIF_UPDATE_QUIESCE_HOOK=/usr/libexec/ai-image-factory/hooks/quiesce
AIF_UPDATE_RESUME_HOOK=/usr/libexec/ai-image-factory/hooks/resume
AIF_UPDATE_BACKUP_HOOK=/usr/libexec/ai-image-factory/hooks/backup
AIF_UPDATE_RECOVER_HOOK=/usr/libexec/ai-image-factory/hooks/recover
AIF_UPDATE_ACTIVATE_HOOK=/usr/libexec/ai-image-factory/hooks/activate
AIF_UPDATE_VERIFY_HOOK=/usr/libexec/ai-image-factory/hooks/verify
# Optional site-specific runtime ownership checks consumed by the verify hook.
# AIF_VERIFY_GATEWAY_BASE_URL=http://127.0.0.1:8789
# AIF_VERIFY_NGINX_CONFIG_PATH=/etc/nginx/sites-enabled/sol42.cn
# AIF_VERIFY_FORBIDDEN_NGINX_PORTS=8787
# AIF_VERIFY_LEGACY_GATEWAY_UNITS=gpt-image-2-gateway.service
AIF_BACKUP_ROOT=/var/lib/ai-image-factory/backups
