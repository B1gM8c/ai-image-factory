# Install as /etc/ai-image-factory/remote-providers/PROFILE_KEY.env, root:root 0600.
# Use provisioned dedicated Canvas account and image-generation execution profile.
# The service user owns the pre-authorized account HOME with mode 0700.
# Register it with factoryctl provision-dreamina-canvas-profile using
# EXECUTOR_CANVAS_CREDENTIAL_HOME and EXECUTOR_CANVAS_ACCOUNT_FINGERPRINT_SHA256.
# Compute the fingerprint as SHA-256 over ASCII ai-image-factory/dreamina-canvas/oauth-user/v1:
# followed immediately by the decimal integer data.userId from authenticated auth account.
# The Gateway and Canvas worker require GATEWAY_IMAGES_GENERATION_CONTRACT=customer-pricing-v4.
# Install and start the dedicated ai-image-factory-canvas-keyring@PROFILE_KEY.service
# before authorization. Canvas uses this service's account-scoped Secret Service.
EXECUTOR_CANVAS_CREDENTIAL_HOME=/var/lib/ai-image-factory/provider-homes/dreamina-canvas/ACCOUNT_DIRECTORY
WORKER_EXECUTION_MODE=executor-handoff
WORKER_MAX_IN_FLIGHT=1
GATEWAY_WORKER_DB_MAX_CONNECTIONS=2
EXECUTOR_PROFILE_KEY=PROFILE_KEY
PROVIDER_SUBMITTER_PROFILE_KEY=PROFILE_KEY
PROVIDER_POLLER_PROFILE_KEY=PROFILE_KEY

# Use a dedicated OAuth profile and private workspace project with no other writers.
# Submit and poll share the Canvas project and OAuth identity. Local state is separate
# from credentials, temporary attempts, artifact storage and submission journals.
DREAMINA_CANVAS_PROJECT_ID=CANVAS_PROJECT_UUID
DREAMINA_CANVAS_OAUTH_PROFILE=factory
DREAMINA_CANVAS_STATE_DIR=/var/lib/ai-image-factory/canvas-state/ACCOUNT_DIRECTORY

PROVIDER_SUBMITTER_ACTIVATION=dreamina-canvas-submit-v1
PROVIDER_SUBMITTER_PROVIDER_TIMEOUT_MS=600000
PROVIDER_SUBMITTER_CLI_WALL_TIMEOUT_MS=60000
PROVIDER_SUBMITTER_CREDENTIAL_POOL_ID=CREDENTIAL_POOL_UUID
PROVIDER_SUBMITTER_ACCOUNT_ID=PROVIDER_ACCOUNT_UUID
PROVIDER_SUBMITTER_CREDENTIAL_REF=CREDENTIAL_REF
PROVIDER_SUBMITTER_CREDENTIAL_REVISION=CREDENTIAL_REVISION
PROVIDER_SUBMITTER_CREDENTIAL_AUTH_SHA256=CREDENTIAL_AUTH_SHA256
PROVIDER_SUBMITTER_ACCOUNT_HOME=/var/lib/ai-image-factory/provider-homes/dreamina-canvas/ACCOUNT_DIRECTORY
PROVIDER_SUBMITTER_WORKSPACE_ROOT=/var/lib/ai-image-factory/remote-runners/PROFILE_KEY/submit
PROVIDER_SUBMITTER_JOURNAL_ROOT=/var/lib/ai-image-factory/remote-journals/PROFILE_KEY
PROVIDER_SUBMITTER_EXECUTABLE=/opt/ai-image-factory/providers/dreamina-canvas/1.4.1/bin/dreamina-canvas
PROVIDER_SUBMITTER_EXECUTABLE_SHA256=0641c18766d57df52d14c8af93ed9fb156e4e5b78ca66272ae3a6b600f8223a7
PROVIDER_SUBMITTER_RUNNER=/opt/ai-image-factory/current/bin/remote-submit-runner
PROVIDER_SUBMITTER_RUNNER_SHA256=RELEASE_RUNNER_SHA256

PROVIDER_POLLER_ACTIVATION=dreamina-canvas-poll-v1
PROVIDER_POLLER_CREDENTIAL_POOL_ID=CREDENTIAL_POOL_UUID
PROVIDER_POLLER_ACCOUNT_ID=PROVIDER_ACCOUNT_UUID
PROVIDER_POLLER_CREDENTIAL_REF=CREDENTIAL_REF
PROVIDER_POLLER_CREDENTIAL_REVISION=CREDENTIAL_REVISION
PROVIDER_POLLER_CREDENTIAL_AUTH_SHA256=CREDENTIAL_AUTH_SHA256
PROVIDER_POLLER_ACCOUNT_HOME=/var/lib/ai-image-factory/provider-homes/dreamina-canvas/ACCOUNT_DIRECTORY
PROVIDER_POLLER_WORKSPACE_ROOT=/var/lib/ai-image-factory/remote-runners/PROFILE_KEY/poll
PROVIDER_POLLER_EXECUTABLE=/opt/ai-image-factory/providers/dreamina-canvas/1.4.1/bin/dreamina-canvas
PROVIDER_POLLER_EXECUTABLE_SHA256=0641c18766d57df52d14c8af93ed9fb156e4e5b78ca66272ae3a6b600f8223a7
PROVIDER_POLLER_MAX_MATERIALIZATIONS=1
PROVIDER_POLLER_MAX_ARTIFACT_BYTES=33554432
