[Unit]
Description=AI Image Factory optional semantic bbox worker
PartOf=ai-image-factory-processes.target
Requires=ai-image-factory-recovery-gate.service
After=network-online.target ai-image-factory-recovery-gate.service
Wants=network-online.target

[Service]
Type=simple
User=ai-image-factory
Group=ai-image-factory
EnvironmentFile=/etc/ai-image-factory/app.env
EnvironmentFile=/etc/ai-image-factory/segments.env
WorkingDirectory=/var/lib/ai-image-factory
ExecStart=/opt/ai-image-factory/current/bin/segmentd
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=ai-image-factory-processes.target
