[Unit]
Description=AI Image Factory Next.js admin console
PartOf=ai-image-factory-processes.target
Requires=ai-image-factory-recovery-gate.service
After=network-online.target ai-image-factory-recovery-gate.service ai-image-factory-gateway.service

[Service]
Type=simple
User=ai-image-factory
Group=ai-image-factory
EnvironmentFile=/etc/ai-image-factory/admin.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3010
Environment=AIF_ADMIN_RUNTIME_ROOT=/var/lib/ai-image-factory/admin-runtime
WorkingDirectory=/opt/ai-image-factory/current/admin
ExecStart=/usr/bin/node /opt/ai-image-factory/current/admin/server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=2min
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/opt/ai-image-factory/current
ReadWritePaths=/var/lib/ai-image-factory/admin-runtime
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=ai-image-factory-processes.target
