DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/ai_image_factory
# Required by release verification: a distinct login with schema USAGE and
# table SELECT, without write/CREATE/grant-option permissions. See bootstrap docs.
GATEWAY_ADMIN_READ_DATABASE_URL=postgresql://ADMIN_READER:PASSWORD@DATABASE_HOST:5432/ai_image_factory
GATEWAY_DATABASE_SCHEMA=public
GATEWAY_ARTIFACT_ROOT=/var/lib/ai-image-factory/artifacts
GATEWAY_PROVIDER_UPLOAD_PUBLIC_BASE_URL=https://media-gateway.example.com
GATEWAY_READINESS_STALL_THRESHOLD_SECS=60
RUST_LOG=info
# xAI-shaped Grok video generation is an explicit, default-off route gate.
# Provision and canary a separate execution profile before setting true.
GATEWAY_ENABLE_XAI_VIDEO_API=false
# Grok V1/V2 executors are selected in /etc/ai-image-factory/executors/*.env,
# not by replacing a shared CLI path. New V2 work must use:
# EXECUTOR_HELPER_EXECUTABLE=/opt/ai-image-factory/current/bin/grok-runner
# EXECUTOR_PROVIDER_EXECUTABLE=/opt/ai-image-factory/current/bin/grok-v2
# V1 replay profiles remain bound to bin/grok-v1 (or bin/grok compatibility).
# Optional semantic bbox API; enable together with the separate segmentd service.
GATEWAY_BBOX_ENABLED=false
GATEWAY_BBOX_MODEL=gpt-5.6-luna
GATEWAY_BBOX_REASONING_EFFORT=none
# Optional in-gateway Codex quota observer. Does not generate images or loosen
# route unknown_quota_policy. Both source cleanup and this loop are opt-in.
GATEWAY_CODEX_QUOTA_AUTO_REFRESH_ENABLED=false
GATEWAY_CODEX_QUOTA_AUTO_REFRESH_INTERVAL_SECONDS=15
GATEWAY_CODEX_QUOTA_AUTO_REFRESH_CONCURRENCY=2
