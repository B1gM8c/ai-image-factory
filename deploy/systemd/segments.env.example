# Explicitly provision an isolated analysis account home, never a generation job home.
GATEWAY_BBOX_CODEX_BIN=/opt/ai-image-factory/provider-tools/codex/0.153.4/bin/codex
GATEWAY_BBOX_CODEX_HOME=/var/lib/ai-image-factory/bbox-codex
# Must match the gateway's settings to select the same queue/cache identity.
GATEWAY_BBOX_MODEL=gpt-5.6-luna
GATEWAY_BBOX_REASONING_EFFORT=none
# Enable only after applying the source-lifecycle migration and verifying the
# consumer stores successful JSON independently of Factory's 24-hour cache.
GATEWAY_BBOX_RELEASE_TERMINAL_SOURCES=false
