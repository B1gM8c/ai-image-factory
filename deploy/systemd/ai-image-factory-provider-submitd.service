[Unit]
Description=AI Image Factory remote provider submitter
PartOf=ai-image-factory.target
After=network-online.target ai-image-factory-workerd.service
Before=ai-image-factory-provider-pollerd.service ai-image-factory-gateway.service

[Service]
Type=simple
User=ai-image-factory
Group=ai-image-factory
EnvironmentFile=/etc/ai-image-factory/app.env
WorkingDirectory=/opt/ai-image-factory/current
ExecStart=/opt/ai-image-factory/current/bin/provider-submitd
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10min
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/opt/ai-image-factory/current
ReadWritePaths=/var/lib/ai-image-factory
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=ai-image-factory.target
