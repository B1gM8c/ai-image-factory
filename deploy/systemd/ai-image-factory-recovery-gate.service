[Unit]
Description=Recover unfinished AI Image Factory updates before application startup
Documentation=file:/usr/share/doc/ai-image-factory/github-release-deployment.md
Wants=network-online.target
After=network-online.target
Before=ai-image-factory-processes.target ai-image-factory.target ai-image-factory-updater.service
OnFailure=ai-image-factory-recovery-failed.service
RequiresMountsFor=/opt/ai-image-factory /var/lib/ai-image-factory

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/ai-image-factory/update-policy.env
EnvironmentFile=/etc/ai-image-factory/updater.env
WorkingDirectory=/var/lib/ai-image-factory/updater
ExecStart=/usr/libexec/ai-image-factory/updated recover-pending
TimeoutStartSec=45min
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/usr/libexec/ai-image-factory
ReadWritePaths=/opt/ai-image-factory
ReadWritePaths=/var/lib/ai-image-factory/artifacts
ReadWritePaths=/var/lib/ai-image-factory/backups
ReadWritePaths=/var/lib/ai-image-factory/updater
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
SystemCallArchitectures=native
