# Copy to /etc/ai-image-factory/remote-providers/PROFILE_KEY.env, root:root 0600.
# One file per account + operation profile; all models share that runtime.
# Replace every placeholder with the provisioned account/profile identity.
# EnvironmentFile overrides template Environment values. Set all three keys to
# the exact instance PROFILE_KEY, including when app.env has legacy bindings.
WORKER_EXECUTION_MODE=executor-handoff
WORKER_MAX_IN_FLIGHT=1
WORKER_POLL_INTERVAL_MS=1000
# Pool size for each dispatcher, submitter and poller (1..64; unset defaults to 10).
# Two image/video profiles use six pools, so 2 caps their total at 12 connections.
# This does not limit account generation concurrency.
GATEWAY_WORKER_DB_MAX_CONNECTIONS=2
EXECUTOR_PROFILE_KEY=PROFILE_KEY
PROVIDER_SUBMITTER_PROFILE_KEY=PROFILE_KEY
PROVIDER_POLLER_PROFILE_KEY=PROFILE_KEY

PROVIDER_SUBMITTER_ACTIVATION=dreamina-remote-submit-v1
# Overall upstream task budget, including queueing and result collection.
# Individual CLI submit/query processes retain their separate 60-second limit.
PROVIDER_SUBMITTER_PROVIDER_TIMEOUT_MS=600000
PROVIDER_SUBMITTER_IDLE_DELAY_MS=1000
PROVIDER_SUBMITTER_CREDENTIAL_POOL_ID=CREDENTIAL_POOL_UUID
PROVIDER_SUBMITTER_ACCOUNT_ID=PROVIDER_ACCOUNT_UUID
PROVIDER_SUBMITTER_CREDENTIAL_REF=CREDENTIAL_REF
PROVIDER_SUBMITTER_CREDENTIAL_REVISION=CREDENTIAL_REVISION
PROVIDER_SUBMITTER_CREDENTIAL_AUTH_SHA256=CREDENTIAL_AUTH_SHA256
PROVIDER_SUBMITTER_ACCOUNT_HOME=/var/lib/ai-image-factory/provider-homes/dreamina/ACCOUNT_DIRECTORY
PROVIDER_SUBMITTER_WORKSPACE_ROOT=/var/lib/ai-image-factory/remote-runners/PROFILE_KEY/submit
PROVIDER_SUBMITTER_JOURNAL_ROOT=/var/lib/ai-image-factory/remote-journals/PROFILE_KEY
PROVIDER_SUBMITTER_EXECUTABLE=/opt/ai-image-factory/providers/dreamina/CLI_VERSION/bin/dreamina
PROVIDER_SUBMITTER_EXECUTABLE_SHA256=CLI_SHA256
PROVIDER_SUBMITTER_RUNNER=/opt/ai-image-factory/current/bin/remote-submit-runner
PROVIDER_SUBMITTER_RUNNER_SHA256=RELEASE_RUNNER_SHA256

PROVIDER_POLLER_ACTIVATION=dreamina-remote-poll-v1
PROVIDER_POLLER_IDLE_DELAY_MS=1000
PROVIDER_POLLER_CREDENTIAL_POOL_ID=CREDENTIAL_POOL_UUID
PROVIDER_POLLER_ACCOUNT_ID=PROVIDER_ACCOUNT_UUID
PROVIDER_POLLER_CREDENTIAL_REF=CREDENTIAL_REF
PROVIDER_POLLER_CREDENTIAL_REVISION=CREDENTIAL_REVISION
PROVIDER_POLLER_CREDENTIAL_AUTH_SHA256=CREDENTIAL_AUTH_SHA256
PROVIDER_POLLER_ACCOUNT_HOME=/var/lib/ai-image-factory/provider-homes/dreamina/ACCOUNT_DIRECTORY
PROVIDER_POLLER_WORKSPACE_ROOT=/var/lib/ai-image-factory/remote-runners/PROFILE_KEY/poll
PROVIDER_POLLER_EXECUTABLE=/opt/ai-image-factory/providers/dreamina/CLI_VERSION/bin/dreamina
PROVIDER_POLLER_EXECUTABLE_SHA256=CLI_SHA256
# Bound concurrent artifact downloads separately from generation capacity.
PROVIDER_POLLER_MAX_MATERIALIZATIONS=1
PROVIDER_POLLER_MAX_ARTIFACT_BYTES=268435456
