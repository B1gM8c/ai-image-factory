[Unit]
Description=AI Image Factory dedicated Canvas OAuth keyring for profile %i

[Service]
Type=exec
User=ai-image-factory
Group=ai-image-factory
EnvironmentFile=/etc/ai-image-factory/remote-providers/%I.env
WorkingDirectory=/opt/ai-image-factory/current
ExecStart=/opt/ai-image-factory/current/bin/factoryctl serve-dreamina-canvas-keyring
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/opt/ai-image-factory/current
ReadWritePaths=/var/lib/ai-image-factory/provider-homes/dreamina-canvas
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
