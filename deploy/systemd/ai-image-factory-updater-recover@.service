[Unit]
Description=Recover AI Image Factory update command %i
Documentation=file:/usr/share/doc/ai-image-factory/github-release-deployment.md
Wants=network-online.target
After=network-online.target
Conflicts=ai-image-factory-updater.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/ai-image-factory/update-policy.env
EnvironmentFile=/etc/ai-image-factory/updater.env
WorkingDirectory=/var/lib/ai-image-factory/updater
ExecStart=/usr/libexec/ai-image-factory/updated recover %i
TimeoutStartSec=45min
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/usr/libexec/ai-image-factory
ReadWritePaths=/opt/ai-image-factory
ReadWritePaths=/var/lib/ai-image-factory/artifacts
ReadWritePaths=/var/lib/ai-image-factory/backups
ReadWritePaths=/var/lib/ai-image-factory/updater
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
SystemCallArchitectures=native
