#!/bin/bash
set -Eeuo pipefail
IFS=$'\n\t'
export PATH="${AIF_QUIESCE_COMMAND_PATH:-/usr/sbin:/usr/bin:/sbin:/bin}"

PROCESS_UNITS=(
  ai-image-factory-reconcilerd.service
  ai-image-factory-executord@default.service
  ai-image-factory-reducerd.service
  ai-image-factory-workerd.service
  ai-image-factory-gateway.service
  ai-image-factory-admin.service
  ai-image-factory-provider-submitd.service
  ai-image-factory-provider-pollerd.service
  ai-image-factory-webhookd.service
)

append_process_unit() {
  local candidate existing
  candidate="$1"
  for existing in "${PROCESS_UNITS[@]}"; do
    [[ "$existing" == "$candidate" ]] && return
  done
  PROCESS_UNITS+=("$candidate")
}

while IFS= read -r unit; do
  case "$unit" in
    ai-image-factory-executord@*.service | ai-image-factory-workerd@*.service)
      append_process_unit "$unit"
      ;;
  esac
done < <(
  systemctl list-units \
    --type=service \
    --state=active,activating,deactivating \
    --no-legend \
    --plain \
    'ai-image-factory-executord@*.service' \
    'ai-image-factory-workerd@*.service' \
    | awk '{print $1}'
)

while IFS= read -r unit; do
  case "$unit" in
    ai-image-factory-executord@*.service | ai-image-factory-workerd@*.service)
      systemctl is-enabled --quiet "$unit" && append_process_unit "$unit"
      ;;
  esac
done < <(
  systemctl list-dependencies \
    --no-legend \
    --plain \
    --full \
    ai-image-factory-processes.target \
    | awk '{print $1}'
)

if ! systemctl stop ai-image-factory-processes.target "${PROCESS_UNITS[@]}"; then
  printf 'systemctl reported a process stop failure; checking final unit state\n' >&2
fi
for unit in ai-image-factory-processes.target "${PROCESS_UNITS[@]}"; do
  active_state="$(systemctl show "$unit" --property=ActiveState --value)"
  main_pid="$(systemctl show "$unit" --property=MainPID --value)"
  # systemd targets do not have a process and report an empty MainPID rather
  # than zero. Treat only that empty value as the process-free state.
  [[ -n "$main_pid" ]] || main_pid=0
  if [[ "$active_state" != "inactive" && "$active_state" != "failed" ]] \
    || [[ "$main_pid" != "0" ]]; then
    printf 'application process unit did not stop cleanly: %s state=%s pid=%s\n' \
      "$unit" "$active_state" "$main_pid" >&2
    exit 1
  fi
done
