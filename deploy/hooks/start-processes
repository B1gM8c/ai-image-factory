#!/bin/bash
set -Eeuo pipefail
IFS=$'\n\t'
export PATH="${AIF_START_COMMAND_PATH:-/usr/sbin:/usr/bin:/sbin:/bin}"

readonly PROCESS_SCOPE="${AIF_UPDATE_PROCESS_SCOPE:-full}"
readonly START_MODE="${AIF_UPDATE_START_MODE:-target}"
case "$PROCESS_SCOPE" in
  validation | full) ;;
  *)
    printf 'unsupported process scope: %s\n' "$PROCESS_SCOPE" >&2
    exit 1
    ;;
esac
case "$START_MODE" in
  target | direct | gate) ;;
  *)
    printf 'unsupported start mode: %s\n' "$START_MODE" >&2
    exit 1
    ;;
esac

readonly VALIDATION_UNITS=(
  ai-image-factory-gateway.service
  ai-image-factory-admin.service
)
REQUIRED_PROFILE_UNITS=()
readonly LEGACY_EXECUTION_UNITS=(
  ai-image-factory-executord@default.service
  ai-image-factory-workerd.service
)
readonly REQUIRED_PREFIX_UNITS=(
  ai-image-factory-reconcilerd.service
)
readonly REQUIRED_SUFFIX_UNITS=(
  ai-image-factory-reducerd.service
)
readonly OPTIONAL_UNITS=(
  ai-image-factory-provider-submitd.service
  ai-image-factory-provider-pollerd.service
  ai-image-factory-webhookd.service
)

if [[ "$PROCESS_SCOPE" == "full" ]]; then
  for unit in "${LEGACY_EXECUTION_UNITS[@]}"; do
    if systemctl is-enabled --quiet "$unit"; then
      REQUIRED_PROFILE_UNITS+=("$unit")
    fi
  done
  while IFS= read -r unit; do
    case "$unit" in
      ai-image-factory-executord@*.service)
        systemctl is-enabled --quiet "$unit" \
          && REQUIRED_PROFILE_UNITS+=("$unit")
        ;;
      ai-image-factory-workerd@*.service)
        systemctl is-enabled --quiet "$unit" \
          && REQUIRED_PROFILE_UNITS+=("$unit")
        ;;
    esac
  done < <(
    systemctl list-dependencies \
      --no-legend \
      --plain \
      --full \
      ai-image-factory-processes.target \
      | awk '{print $1}'
  )
fi

if [[ "$START_MODE" == "gate" ]]; then
  if [[ "$PROCESS_SCOPE" == "validation" ]]; then
    systemctl --job-mode=ignore-dependencies start "${VALIDATION_UNITS[0]}"
    systemctl --job-mode=ignore-dependencies start "${VALIDATION_UNITS[1]}"
    exit 0
  fi

  systemctl --job-mode=ignore-dependencies start "${REQUIRED_PREFIX_UNITS[@]}"
  if (( ${#REQUIRED_PROFILE_UNITS[@]} > 0 )); then
    systemctl --job-mode=ignore-dependencies start "${REQUIRED_PROFILE_UNITS[@]}"
  fi
  systemctl --job-mode=ignore-dependencies start "${REQUIRED_SUFFIX_UNITS[@]}"
  for unit in "${OPTIONAL_UNITS[@]}"; do
    if systemctl is-enabled --quiet "$unit"; then
      systemctl --job-mode=ignore-dependencies start "$unit"
    fi
  done
  systemctl --job-mode=ignore-dependencies start "${VALIDATION_UNITS[0]}"
  systemctl --job-mode=ignore-dependencies start "${VALIDATION_UNITS[1]}"
  systemctl --job-mode=ignore-dependencies start ai-image-factory-processes.target
  systemctl is-active --quiet ai-image-factory-processes.target
  exit 0
fi

START_COMMAND=(systemctl start)
if [[ "$START_MODE" == "direct" ]]; then
  START_COMMAND=(systemctl --job-mode=ignore-requirements start)
fi

if [[ "$PROCESS_SCOPE" == "validation" ]]; then
  "${START_COMMAND[@]}" "${VALIDATION_UNITS[@]}"
  exit 0
fi

START_UNITS=("${REQUIRED_PREFIX_UNITS[@]}")
if (( ${#REQUIRED_PROFILE_UNITS[@]} > 0 )); then
  START_UNITS+=("${REQUIRED_PROFILE_UNITS[@]}")
fi
START_UNITS+=("${REQUIRED_SUFFIX_UNITS[@]}" "${VALIDATION_UNITS[@]}")
"${START_COMMAND[@]}" "${START_UNITS[@]}"
for unit in "${OPTIONAL_UNITS[@]}"; do
  if systemctl is-enabled --quiet "$unit"; then
    "${START_COMMAND[@]}" "$unit"
  fi
done
if [[ "$START_MODE" == "direct" ]]; then
  "${START_COMMAND[@]}" \
    ai-image-factory-processes.target \
    ai-image-factory.target
  systemctl is-active --quiet ai-image-factory.target
else
  "${START_COMMAND[@]}" ai-image-factory-processes.target
fi
systemctl is-active --quiet ai-image-factory-processes.target
