#!/bin/bash
set -Eeuo pipefail
IFS=$'\n\t'
export PATH="${AIF_VERIFY_COMMAND_PATH:-/usr/sbin:/usr/bin:/sbin:/bin}"

die() {
  printf 'gateway runtime gate: %s\n' "$*" >&2
  exit 1
}

readonly GATEWAY_UNIT="${AIF_VERIFY_GATEWAY_UNIT:-ai-image-factory-gateway.service}"
readonly GATEWAY_BASE_URL="${AIF_VERIFY_GATEWAY_BASE_URL:-http://127.0.0.1:8787}"
readonly CURRENT_LINK="${AIF_VERIFY_CURRENT_RELEASE_LINK:-/opt/ai-image-factory/current}"
readonly PROC_ROOT="${AIF_VERIFY_PROC_ROOT:-/proc}"
readonly RELEASE_UNITS="${AIF_VERIFY_RELEASE_UNITS:-${GATEWAY_UNIT}}"
readonly NGINX_CONFIG="${AIF_VERIFY_NGINX_CONFIG_PATH:-}"
readonly LEGACY_UNITS="${AIF_VERIFY_LEGACY_GATEWAY_UNITS:-gpt-image-2-gateway.service}"
readonly FORBIDDEN_NGINX_PORTS="${AIF_VERIFY_FORBIDDEN_NGINX_PORTS:-}"
readonly PROVIDER_MANIFEST_NAME="provider-manifest.json"

[[ "$GATEWAY_BASE_URL" =~ ^http://127\.0\.0\.1:([0-9]+)(/.*)?$ ]] \
  || die "gateway base URL must use an explicit 127.0.0.1 port"
readonly GATEWAY_PORT="${BASH_REMATCH[1]}"

main_pid="$(systemctl show "$GATEWAY_UNIT" --property=MainPID --value)"
[[ "$main_pid" =~ ^[1-9][0-9]*$ ]] || die "gateway unit has no live MainPID"
[[ -d "${PROC_ROOT}/${main_pid}" ]] || die "gateway MainPID is not running: ${main_pid}"

owner_pids=()
while IFS= read -r owner_pid; do
  [[ -n "$owner_pid" ]] && owner_pids+=("$owner_pid")
done < <(
  ss -H -ltnp "sport = :${GATEWAY_PORT}" \
    | grep -oE 'pid=[0-9]+' \
    | cut -d= -f2 \
    | sort -u
)
[[ "${#owner_pids[@]}" -eq 1 ]] \
  || die "gateway port ${GATEWAY_PORT} must have exactly one owner"
[[ "${owner_pids[0]}" == "$main_pid" ]] \
  || die "gateway port owner ${owner_pids[0]} does not match unit MainPID ${main_pid}"

release_root="$(readlink -f "$CURRENT_LINK")"
gateway_exe="$(readlink -f "${PROC_ROOT}/${main_pid}/exe")"
[[ "$release_root" == */releases/* ]] \
  || die "current release does not resolve inside an immutable releases directory"
case "$gateway_exe" in
  "${release_root}"/*) ;;
  *) die "gateway executable is outside the current release: ${gateway_exe}" ;;
esac

provider_manifest="${release_root}/${PROVIDER_MANIFEST_NAME}"
provider_executable="$(readlink -f "${release_root}/bin/grok")"
[[ -f "$provider_manifest" && ! -L "$provider_manifest" ]] \
  || die "Grok provider manifest is missing from the current release"
[[ "$provider_executable" == "${release_root}/bin/grok" && -x "$provider_executable" ]] \
  || die "Grok provider executable is outside the current release"
provider_fields="$(
  env PROVIDER_MANIFEST="$provider_manifest" python3 <<'PY'
import json
import os
import re

with open(os.environ["PROVIDER_MANIFEST"], "r", encoding="utf-8") as handle:
    manifest = json.load(handle)
if (
    manifest.get("schema_version") != 1
    or manifest.get("provider") != "xai-grok-cli"
    or manifest.get("binary_path") != "bin/grok"
    or not re.fullmatch(r"[0-9a-f]{64}", str(manifest.get("binary_sha256", "")))
    or not re.fullmatch(r"grok 1\.0\.5 \([0-9a-f]+\)", str(manifest.get("version_output", "")))
    or manifest.get("compatibility_revision") != "grok-cli-1.0.5"
    or manifest.get("image_adapter_revision") != "grok-cli-1.0.5.agentic-media.v2"
    or manifest.get("video_adapter_revision") != "grok-api-1.0.5.direct-image-video.v3"
):
    raise SystemExit("invalid provider manifest")
print(manifest["binary_sha256"])
print(manifest["version_output"])
PY
)" || die "Grok provider manifest is invalid"
provider_sha256="$(printf '%s\n' "$provider_fields" | sed -n '1p')"
provider_version="$(printf '%s\n' "$provider_fields" | sed -n '2p')"
[[ "$(sha256sum "$provider_executable" | awk '{print $1}')" == "$provider_sha256" ]] \
  || die "Grok provider executable digest differs from the release manifest"
[[ "$($provider_executable --version)" == "$provider_version" ]] \
  || die "Grok provider executable version differs from the release manifest"

provider_binding_count=0
while IFS= read -r release_unit; do
  [[ -n "$release_unit" ]] || continue
  unit_pid="$(systemctl show "$release_unit" --property=MainPID --value)"
  [[ "$unit_pid" =~ ^[1-9][0-9]*$ ]] \
    || die "release unit has no live MainPID: ${release_unit}"
  [[ -d "${PROC_ROOT}/${unit_pid}" ]] \
    || die "release unit MainPID is not running: ${release_unit} ${unit_pid}"
  unit_exe="$(readlink -f "${PROC_ROOT}/${unit_pid}/exe")"
  case "$unit_exe" in
    "${release_root}"/*) ;;
    *) die "release unit executable is outside the current release: ${release_unit} ${unit_exe}" ;;
  esac
  case "$release_unit" in
    ai-image-factory-executord@*.service)
      managed_provider="$(
        tr '\0' '\n' <"${PROC_ROOT}/${unit_pid}/environ" \
          | sed -n 's/^GATEWAY_MANAGED_GROK_EXECUTABLE=//p'
      )"
      fallback_provider="$(
        tr '\0' '\n' <"${PROC_ROOT}/${unit_pid}/environ" \
          | sed -n 's/^EXECUTOR_GROK_EXECUTABLE=//p'
      )"
      configured_provider="${managed_provider:-${fallback_provider}}"
      [[ -n "$configured_provider" ]] \
        || die "executor PID does not expose its Grok provider binding: ${release_unit}"
      [[ "$(readlink -f "$configured_provider")" == "$provider_executable" ]] \
        || die "executor PID is not bound to the current release Grok provider: ${release_unit}"
      provider_binding_count=$((provider_binding_count + 1))
      ;;
  esac
done < <(printf '%s\n' "$RELEASE_UNITS" | tr ',' '\n')
((provider_binding_count > 0)) \
  || die "no running executor PID proved the current Grok provider binding"

while IFS= read -r legacy_unit; do
  [[ -n "$legacy_unit" ]] || continue
  load_state="$(systemctl show "$legacy_unit" --property=LoadState --value 2>/dev/null || true)"
  [[ -n "$load_state" && "$load_state" != "not-found" ]] || continue
  ! systemctl is-enabled --quiet "$legacy_unit" \
    || die "legacy gateway unit is enabled: ${legacy_unit}"
  ! systemctl is-active --quiet "$legacy_unit" \
    || die "legacy gateway unit is active: ${legacy_unit}"
done < <(printf '%s\n' "$LEGACY_UNITS" | tr ',' '\n')

if [[ -n "$NGINX_CONFIG" ]]; then
  [[ -f "$NGINX_CONFIG" ]] || die "nginx config does not exist: ${NGINX_CONFIG}"
  grep -Eq \
    "^[[:space:]]*proxy_pass[[:space:]]+http://127\\.0\\.0\\.1:${GATEWAY_PORT}([/;[:space:]]|$)" \
    "$NGINX_CONFIG" \
    || die "nginx config does not route to gateway port ${GATEWAY_PORT}"
  while IFS= read -r forbidden_port; do
    [[ -n "$forbidden_port" ]] || continue
    if grep -Eq \
      "^[[:space:]]*proxy_pass[[:space:]]+http://127\\.0\\.0\\.1:${forbidden_port}([/;[:space:]]|$)" \
      "$NGINX_CONFIG"; then
      die "nginx config still routes to forbidden gateway port ${forbidden_port}"
    fi
  done < <(printf '%s\n' "$FORBIDDEN_NGINX_PORTS" | tr ',' '\n')
fi

printf 'gateway runtime gate passed: unit=%s pid=%s port=%s release=%s\n' \
  "$GATEWAY_UNIT" "$main_pid" "$GATEWAY_PORT" "$release_root"
