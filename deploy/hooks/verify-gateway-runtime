#!/bin/bash
set -Eeuo pipefail
IFS=$'\n\t'
export PATH="${AIF_VERIFY_COMMAND_PATH:-/usr/sbin:/usr/bin:/sbin:/bin}"

die() {
  printf 'gateway runtime gate: %s\n' "$*" >&2
  exit 1
}

readonly GATEWAY_UNIT="${AIF_VERIFY_GATEWAY_UNIT:-ai-image-factory-gateway.service}"
readonly GATEWAY_BASE_URL="${AIF_VERIFY_GATEWAY_BASE_URL:-http://127.0.0.1:8787}"
readonly CURRENT_LINK="${AIF_VERIFY_CURRENT_RELEASE_LINK:-/opt/ai-image-factory/current}"
readonly PROC_ROOT="${AIF_VERIFY_PROC_ROOT:-/proc}"
readonly RELEASE_UNITS="${AIF_VERIFY_RELEASE_UNITS:-${GATEWAY_UNIT}}"
readonly NGINX_CONFIG="${AIF_VERIFY_NGINX_CONFIG_PATH:-}"
readonly LEGACY_UNITS="${AIF_VERIFY_LEGACY_GATEWAY_UNITS:-gpt-image-2-gateway.service}"
readonly FORBIDDEN_NGINX_PORTS="${AIF_VERIFY_FORBIDDEN_NGINX_PORTS:-}"
readonly PROVIDER_MANIFEST_NAME="provider-manifest.json"
readonly PROCESS_SCOPE="${AIF_UPDATE_PROCESS_SCOPE:-full}"

case "$PROCESS_SCOPE" in
  validation | full) ;;
  *) die "unsupported process scope: ${PROCESS_SCOPE}" ;;
esac

[[ "$GATEWAY_BASE_URL" =~ ^http://127\.0\.0\.1:([0-9]+)(/.*)?$ ]] \
  || die "gateway base URL must use an explicit 127.0.0.1 port"
readonly GATEWAY_PORT="${BASH_REMATCH[1]}"

main_pid="$(systemctl show "$GATEWAY_UNIT" --property=MainPID --value)"
[[ "$main_pid" =~ ^[1-9][0-9]*$ ]] || die "gateway unit has no live MainPID"
[[ -d "${PROC_ROOT}/${main_pid}" ]] || die "gateway MainPID is not running: ${main_pid}"

owner_pids=()
while IFS= read -r owner_pid; do
  [[ -n "$owner_pid" ]] && owner_pids+=("$owner_pid")
done < <(
  ss -H -ltnp "sport = :${GATEWAY_PORT}" \
    | grep -oE 'pid=[0-9]+' \
    | cut -d= -f2 \
    | sort -u
)
[[ "${#owner_pids[@]}" -eq 1 ]] \
  || die "gateway port ${GATEWAY_PORT} must have exactly one owner"
[[ "${owner_pids[0]}" == "$main_pid" ]] \
  || die "gateway port owner ${owner_pids[0]} does not match unit MainPID ${main_pid}"

release_root="$(readlink -f "$CURRENT_LINK")"
gateway_exe="$(readlink -f "${PROC_ROOT}/${main_pid}/exe")"
[[ "$release_root" == */releases/* ]] \
  || die "current release does not resolve inside an immutable releases directory"
case "$gateway_exe" in
  "${release_root}"/*) ;;
  *) die "gateway executable is outside the current release: ${gateway_exe}" ;;
esac

provider_manifest="${release_root}/${PROVIDER_MANIFEST_NAME}"
[[ -f "$provider_manifest" && ! -L "$provider_manifest" ]] \
  || die "Grok provider manifest is missing from the current release"
release_identity="${release_root}/release.json"
[[ -f "$release_identity" && ! -L "$release_identity" ]] \
  || die "release identity is missing from the current release"
provider_fields="$(
  env PROVIDER_MANIFEST="$provider_manifest" RELEASE_IDENTITY="$release_identity" python3 <<'PY'
import json
import os
import re
import stat
import struct
import hashlib

with open(os.environ["PROVIDER_MANIFEST"], "r", encoding="utf-8") as handle:
    manifest = json.load(handle)
with open(os.environ["RELEASE_IDENTITY"], "r", encoding="utf-8") as handle:
    identity = json.load(handle)
if identity.get("schema_version") != 1:
    raise SystemExit("invalid release identity")
target = identity.get("target_triple")
machines = {"x86_64-unknown-linux-gnu": 62, "aarch64-unknown-linux-gnu": 183}
if target not in machines or manifest.get("schema_version") != 1 or manifest.get("provider") != "xai-grok-cli":
    raise SystemExit("invalid provider manifest identity")
root = os.path.dirname(os.environ["PROVIDER_MANIFEST"])
required = {"generation", "version", "version_output", "target_triple", "binary_path", "binary_sha256", "binary_bytes", "elf_machine", "compatibility_revision", "image_adapter_revision", "video_adapter_revision"}
def check(generation, entry, expected_path):
    if not isinstance(entry, dict) or set(entry) != required or entry.get("generation") != generation or entry.get("binary_path") != expected_path:
        raise SystemExit(f"incomplete {generation} runtime manifest")
    if entry.get("target_triple") != target or entry.get("elf_machine") != machines[target]:
        raise SystemExit(f"{generation} target mismatch")
    expected = {
        "v1": ("1.0.5", "grok 1.0.5 (5115b46bc9)", "grok-cli-1.0.5", "grok-cli-1.0.5.agentic-media.v2", "grok-api-1.0.5.direct-image-video.v5"),
        "v2": ("1.0.34", "grok 1.0.34 (3736acbc8658)", "grok-cli-1.0.34", None, "grok-cli-1.0.34.agentic-video.v1"),
    }[generation]
    if tuple(entry.get(k) for k in ("version", "version_output", "compatibility_revision", "image_adapter_revision", "video_adapter_revision")) != expected:
        raise SystemExit(f"{generation} runtime version/adapter metadata mismatch")
    expected_sha, size = entry.get("binary_sha256"), entry.get("binary_bytes")
    if not isinstance(expected_sha, str) or not re.fullmatch(r"[0-9a-f]{64}", expected_sha) or not isinstance(size, int) or size <= 0:
        raise SystemExit(f"invalid {generation} digest/size")
    path = os.path.join(root, expected_path)
    try:
        st = os.lstat(path)
    except OSError:
        raise SystemExit(f"missing {generation} runtime")
    digest = hashlib.sha256()
    size_seen = 0
    header = bytearray()
    with open(path, "rb") as binary:
        while chunk := binary.read(1024 * 1024):
            digest.update(chunk)
            size_seen += len(chunk)
            if len(header) < 64:
                header.extend(chunk[:64 - len(header)])
    if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1 or not st.st_mode & 0o111:
        raise SystemExit(f"{generation} runtime is not a regular executable")
    if size_seen != size or digest.hexdigest() != expected_sha:
        raise SystemExit(f"{generation} runtime identity mismatch")
    data = bytes(header)
    if len(data) < 20 or data[:4] != b"\x7fELF" or data[4] != 2 or data[5] != 1 or struct.unpack_from("<H", data, 18)[0] != machines[target]:
        raise SystemExit(f"{generation} runtime is not target ELF64 LE")
    return entry
runtimes = manifest.get("runtimes")
if runtimes is None:
    if manifest.get("binary_path") != "bin/grok":
        raise SystemExit("legacy provider manifest path mismatch")
    legacy_required = ("version", "version_output", "target_triple", "binary_sha256", "binary_bytes", "source_repository")
    if any(key not in manifest for key in legacy_required) or manifest.get("target_triple") != target:
        raise SystemExit("legacy provider manifest is incomplete or targets a different release")
    path = os.path.join(root, "bin/grok")
    entry = {"generation": "v1", "version": manifest["version"], "version_output": manifest["version_output"], "target_triple": manifest["target_triple"], "binary_path": "bin/grok", "binary_sha256": manifest["binary_sha256"], "binary_bytes": manifest["binary_bytes"], "elf_machine": machines[target], "compatibility_revision": manifest.get("compatibility_revision"), "image_adapter_revision": manifest.get("image_adapter_revision"), "video_adapter_revision": manifest.get("video_adapter_revision")}
    check("v1", entry, "bin/grok")
    if (manifest.get("provider") != "xai-grok-cli" or manifest.get("source_repository") != "https://github.com/xai-org/grok-build"
            or not isinstance(entry["version_output"], str)):
        raise SystemExit("invalid legacy version output")
    print("legacy|v1|bin/grok|" + entry["binary_sha256"] + "|" + entry["version_output"])
else:
    if not isinstance(runtimes, dict) or set(runtimes) != {"v1", "v2"}:
        raise SystemExit("dual provider manifest must contain exactly v1 and v2")
    v1, v2 = check("v1", runtimes["v1"], "bin/grok-v1"), check("v2", runtimes["v2"], "bin/grok-v2")
    if manifest.get("binary_path") != "bin/grok":
        raise SystemExit("dual compatibility path mismatch")
    compat = os.path.join(root, "bin/grok")
    st = os.lstat(compat)
    compat_hash = hashlib.sha256(); compat_size = 0
    with open(compat, "rb") as binary:
        while chunk := binary.read(1024 * 1024):
            compat_hash.update(chunk); compat_size += len(chunk)
    if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1 or not st.st_mode & 0o111 or compat_size != v1["binary_bytes"] or compat_hash.hexdigest() != v1["binary_sha256"]:
        raise SystemExit("compatibility copy differs from V1")
    if manifest.get("binary_sha256") != v1["binary_sha256"] or manifest.get("binary_bytes") != v1["binary_bytes"]:
        raise SystemExit("top-level identity differs from V1")
    for key in ("version", "version_output", "target_triple", "compatibility_revision", "image_adapter_revision", "video_adapter_revision"):
        if manifest.get(key) != v1.get(key):
            raise SystemExit(f"top-level V1 identity differs for {key}")
    if manifest.get("source_repository") != "https://github.com/xai-org/grok-build":
        raise SystemExit("dual provider source repository mismatch")
    for entry in (v1, v2):
        print("dual|" + entry["generation"] + "|" + entry["binary_path"] + "|" + entry["binary_sha256"] + "|" + entry["version_output"])
    print("dual|compat|bin/grok|" + v1["binary_sha256"] + "|" + v1["version_output"])
PY
)" || die "Grok provider manifest is invalid"
target_triple="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["target_triple"])' "$release_identity")"
target_arch="${target_triple%%-*}"
version_checks=false
[[ "$(uname -s)" == Linux && "$(uname -m)" == "$target_arch" ]] && version_checks=true
while IFS='|' read -r mode generation binary_path _expected_sha expected_version; do
  [[ -n "$mode" ]] || continue
  # The manifest parser above validates the SHA; retain this field for the pipe shape.
  binary_executable="${release_root}/${binary_path}"
  if [[ "$version_checks" == true ]]; then
    [[ "$($binary_executable --version)" == "$expected_version" ]] || die "${generation} Grok provider executable version differs from the release manifest"
  fi
done <<< "$provider_fields"

provider_binding_count=0
while IFS= read -r release_unit; do
  [[ -n "$release_unit" ]] || continue
  unit_pid="$(systemctl show "$release_unit" --property=MainPID --value)"
  [[ "$unit_pid" =~ ^[1-9][0-9]*$ ]] \
    || die "release unit has no live MainPID: ${release_unit}"
  [[ -d "${PROC_ROOT}/${unit_pid}" ]] \
    || die "release unit MainPID is not running: ${release_unit} ${unit_pid}"
  unit_exe="$(readlink -f "${PROC_ROOT}/${unit_pid}/exe")"
  case "$unit_exe" in
    "${release_root}"/*) ;;
    *) die "release unit executable is outside the current release: ${release_unit} ${unit_exe}" ;;
  esac
  case "$release_unit" in
    ai-image-factory-executord@*.service)
      env_file="${PROC_ROOT}/${unit_pid}/environ"
      [[ -r "$env_file" ]] || die "executor PID environment is unavailable: ${release_unit}"
      env_lines="$(tr '\0' '\n' <"$env_file")"
      trim_value() { sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'; }
      helper="$(printf '%s\n' "$env_lines" | sed -n 's/^EXECUTOR_HELPER_EXECUTABLE=//p' | head -n1 | trim_value)"
      [[ -n "$helper" ]] || die "executor helper is missing: ${release_unit}"
      helper_path="$(readlink -f "$helper")"
      case "$helper_path" in
        "${release_root}"/*) ;;
        *) die "executor helper is outside the current release: ${release_unit}" ;;
      esac
      case "$(basename "$helper_path")" in
        grok-runner) executor_kind=grok ;;
        codex-runner) executor_kind=codex ;;
        *) die "unknown executor helper: ${release_unit}" ;;
      esac
      generic_provider="$(printf '%s\n' "$env_lines" | sed -n 's/^EXECUTOR_PROVIDER_EXECUTABLE=//p' | head -n1 | trim_value)"
      if [[ -n "$generic_provider" ]]; then
        configured_provider="$generic_provider"
      elif [[ "$executor_kind" == grok ]]; then
        configured_provider="$(printf '%s\n' "$env_lines" | sed -n 's/^EXECUTOR_GROK_EXECUTABLE=//p' | head -n1 | trim_value)"
      else
        configured_provider="$(printf '%s\n' "$env_lines" | sed -n 's/^EXECUTOR_CODEX_EXECUTABLE=//p' | head -n1 | trim_value)"
      fi
      [[ -n "$configured_provider" ]] || die "executor provider executable is missing: ${release_unit}"
      provider_path="$(readlink -f "$configured_provider")"
      if [[ "$executor_kind" == grok ]]; then
        case "$provider_path" in
          "${release_root}/bin/grok"|"${release_root}/bin/grok-v1"|"${release_root}/bin/grok-v2") ;;
          *) die "Grok executor is not bound to a manifest runtime: ${release_unit}" ;;
        esac
        provider_binding_count=$((provider_binding_count + 1))
      fi
      ;;
  esac
done < <(printf '%s\n' "$RELEASE_UNITS" | tr ',' '\n')
# Validation intentionally starts only gateway/admin. The updater must pass the
# full gate after starting workers and before reopening public admission.
if [[ "$PROCESS_SCOPE" == "full" ]]; then
  ((provider_binding_count > 0)) \
    || die "no running executor PID proved the current Grok provider binding"
fi

while IFS= read -r legacy_unit; do
  [[ -n "$legacy_unit" ]] || continue
  load_state="$(systemctl show "$legacy_unit" --property=LoadState --value 2>/dev/null || true)"
  [[ -n "$load_state" && "$load_state" != "not-found" ]] || continue
  ! systemctl is-enabled --quiet "$legacy_unit" \
    || die "legacy gateway unit is enabled: ${legacy_unit}"
  ! systemctl is-active --quiet "$legacy_unit" \
    || die "legacy gateway unit is active: ${legacy_unit}"
done < <(printf '%s\n' "$LEGACY_UNITS" | tr ',' '\n')

if [[ -n "$NGINX_CONFIG" ]]; then
  [[ -f "$NGINX_CONFIG" ]] || die "nginx config does not exist: ${NGINX_CONFIG}"
  grep -Eq \
    "^[[:space:]]*proxy_pass[[:space:]]+http://127\\.0\\.0\\.1:${GATEWAY_PORT}([/;[:space:]]|$)" \
    "$NGINX_CONFIG" \
    || die "nginx config does not route to gateway port ${GATEWAY_PORT}"
  while IFS= read -r forbidden_port; do
    [[ -n "$forbidden_port" ]] || continue
    if grep -Eq \
      "^[[:space:]]*proxy_pass[[:space:]]+http://127\\.0\\.0\\.1:${forbidden_port}([/;[:space:]]|$)" \
      "$NGINX_CONFIG"; then
      die "nginx config still routes to forbidden gateway port ${forbidden_port}"
    fi
  done < <(printf '%s\n' "$FORBIDDEN_NGINX_PORTS" | tr ',' '\n')
fi

printf 'gateway runtime gate passed: unit=%s pid=%s port=%s release=%s\n' \
  "$GATEWAY_UNIT" "$main_pid" "$GATEWAY_PORT" "$release_root"
